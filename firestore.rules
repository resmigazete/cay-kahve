rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Yardımcı fonksiyonlar ----------
    function signedIn() {
      return request.auth != null;
    }

    // Yönetici: /admins/{uid} belgesi olan e-posta/şifre kullanıcısı
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Sipariş alımı yönetici tarafından kapatılmış mı?
    function orderingOpen() {
      return !exists(/databases/$(database)/documents/settings/app)
        || get(/databases/$(database)/documents/settings/app).data.get('orderingOpen', true) == true;
    }

    function validNewOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly(['number', 'dayKey', 'customerType', 'userId', 'name', 'qrId', 'qrName',
                               'ownerUid', 'items', 'note', 'status', 'createdAt', 'times'])
        && d.keys().hasAll(['number', 'dayKey', 'customerType', 'name', 'ownerUid', 'items', 'status', 'createdAt'])
        && d.ownerUid == request.auth.uid
        && d.status == 'new'
        && d.createdAt == request.time
        && d.number is int && d.number > 0
        && d.dayKey is string && d.dayKey.size() == 10
        && d.customerType in ['user', 'guest']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.items is list && d.items.size() > 0 && d.items.size() <= 30
        && (!('note' in d) || (d.note is string && d.note.size() <= 300))
        && (!('times' in d) || (d.times is map && d.times.size() == 0));
    }

    // ---------- Yönetici kayıtları ----------
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // sadece Firebase Console'dan eklenir
    }

    // ---------- Herkesin okuyabildiği, sadece yöneticinin yazabildiği veriler ----------
    match /users/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /drinks/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /qrcodes/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- Günlük sipariş sayacı (sipariş numarası için) ----------
    match /counters/{day} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == 1;
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
      allow delete: if isAdmin();
    }

    // ---------- Siparişler ----------
    match /orders/{orderId} {
      // Yönetici hepsini, diğerleri yalnızca kendi siparişlerini görür
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if signedIn() && orderingOpen() && validNewOrder();

      // Yönetici her şeyi güncelleyebilir.
      // Sipariş sahibi yalnızca "yeni" durumdaki siparişini iptal edebilir.
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.ownerUid == request.auth.uid
            && resource.data.status == 'new'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'times']));

      allow delete: if isAdmin();
    }
  }
}
